# environment settings > dev or prod
ENV=dev

# graylog settings
GRAYLOG_URL=
GRAYLOG_USERNAME=
GRAYLOG_PASSWORD=

GRAYLOG_SEARCH_QUERY_INTERVAL=15
GRAYLOG_MAX_SEARCH_QUERY_INTERVAL=1440
GRAYLOG_SEARCH_QUERY_LIMIT=9999

# smtp settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_FROM_EMAIL_APP_PASSWORD=
SMTP_TO_EMAILS=
SMTP_CC_EMAILS=

# teams workflow settings
TEAMS_WORKFLOW_URL= # MSTeams > Workflows > Post to a channel when a webhook request is received
